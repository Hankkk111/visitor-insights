DUCKDB_PATH=

# Set to query MotherDuck instead of the local file (after `visitor-pipeline run --publish`)
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=visitor_insights

# "Ask the data" agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
